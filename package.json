{
  "name": "@defisaver/tx-sender",
  "version": "0.1.0",
  "description": "Provider-agnostic transaction orchestration SDK for DeFi Saver: encoding, estimation, Safe multisig signing, TxSaver and EIP-5792 batching. Bring your own chain adapter (viem, web3, ethers).",
  "license": "MIT",
  "repository": "https://github.com/defisaver/defisaver-tx-sender",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "scripts": {
    "build:esm": "rm -rf esm && tsc -p tsconfig.esm.json",
    "build:cjs": "rm -rf cjs && tsc -p tsconfig.cjs.json",
    "build": "npm run lint && npm run build:cjs && npm run build:esm",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/ --fix",
    "lint-check": "eslint src/",
    "test": "mocha tests/*",
    "test-single": "mocha ./tests/$npm_config_name.ts",
    "test:debugger": "mocha --inspect-brk tests/*",
    "version-bump": "git commit -am \"Version bump to $(npm version patch | cut -c 2-)\""
  },
  "dependencies": {
    "@defisaver/sdk": "^1.3.35",
    "@defisaver/tokens": "^1.7.46",
    "decimal.js": "^10.6.0",
    "semver": "^7.8.5",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@defisaver/eslint-config": "^1.0.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "chai": "^4.3.8",
    "dotenv": "^16.3.1",
    "eslint": "^8.49.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-webpack-plugin": "^4.0.1",
    "mocha": "^10.2.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "defisaver",
    "ethereum",
    "transactions",
    "safe",
    "multisig",
    "viem",
    "web3"
  ]
}
