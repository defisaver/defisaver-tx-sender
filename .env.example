# Copy to .env (git-ignored). Never commit real keys.

# Private key used by signature tests. Any throwaway key works; the default Hardhat/Anvil
# account #1 key is fine for local runs. Tests that need it are skipped when it is missing.
TEST_PRIVATE_KEY=

# Optional RPC URLs for future fork-based tests.
RPC=
RPCARB=
RPCBASE=
RPCOPT=
